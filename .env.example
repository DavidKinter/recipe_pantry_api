# Recipe Pantry API - Environment Variables
# Instructions: Copy this file to .env and replace the example values with real ones

# Database connection string
# For local development: Use your PostgreSQL info
# For Render deployment: Copy the "External Database URL" from your Render database
DATABASE_URL=postgresql://username:password@localhost/recipe_pantry_api_dev

# Security keys (IMPORTANT: Change these to random values!)
# Quick way to generate: Just type random letters/numbers (at least 32 characters)
# Or use this command: openssl rand -hex 32
SECRET_KEY=change-this-to-something-random-like-a8f7d9s8f7ds98f7
JWT_SECRET_KEY=change-this-to-something-different-like-98sd7f98sd7f98
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# Admin secret (pick a password that only you know)
# This lets you create admin accounts at /auth/signup-admin
ADMIN_SECRET=pick-your-own-admin-password

# CORS settings (which websites can use your API)
# Keep as-is for now (Postman and Swagger always work)
# If you build a frontend later, add its URL here
CORS_ORIGINS=http://localhost:3000

# Anthropic API key for V2 GenAI features (Pantry AI dish suggestions)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Note for deployment:
# Don't add PORT here - Render sets it automatically
