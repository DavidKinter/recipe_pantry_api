DATABASE_URL=postgresql://username@localhost/database_name
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30

# Admin creation secret - protects admin signup endpoint
# Set this to a secret value only admins know
ADMIN_SECRET=change_this_to_something_secure
