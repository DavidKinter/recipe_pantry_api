						{
							"listen": "test",
							"script": {
								"exec": [
									"// This may fail if user doesn't exist - that's OK",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('cleanupToken1', response.access_token);",
									"    console.log('Found existing user 1 - will clean up');",
									"} else {",
									"    pm.collectionVariables.set('cleanupToken1', '');",
									"    console.log('User 1 does not exist - no cleanup needed');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Skip test assertions for cleanup",
									"pm.test.skip('Cleanup step - no assertions needed', function() {});"
